APP_KEY=base64:KMrXJ0q9n09wtF2mmeau85rZXcZnzWRIAdkGNSaqIwc= # Note, this is a dummy key, you should generate your own key using `php artisan key:generate`
APP_ENV=production
APP_DEBUG=false
APP_URL=https://<your-domain>.com
APP_LOCALE=sv # en or sv according to preferences

# Comma-separated proxy IPs/CIDRs. Use the addresses of your reverse proxy in production.
TRUSTED_PROXIES=*

DB_HOST=host.docker.internal # Set your database host here
DB_DATABASE=ledningssystemet_opensource # Set your database name here
DB_USERNAME=ledningssystemet # Set your database username here
DB_PASSWORD=ledningssystemet # Set your database password here

# Single sign-on configuration (register the callback URL shown below with each IdP).
#AZURE_CLIENT_ID="<client id>"
#AZURE_CLIENT_SECRET="<client secret>"
#AZURE_TENANT_ID="<tenant id>"
#AZURE_REDIRECT_URI="${APP_URL}/oauthcallback"
#AZURE_SCOPE="openid,email,profile,offline_access,User.Read"
#GOOGLE_CLIENT_ID="<client id>"
#GOOGLE_CLIENT_SECRET="<client secret>"
#GOOGLE_REDIRECT_URI="${APP_URL}/sso/google/callback"
#GOOGLE_SCOPE="openid,email,profile"
