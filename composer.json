{
    "name": "ledningssystemet/ledningssystemet",
    "type": "library",
    "description": "Ledningssystemet Open Source.",
    "keywords": ["ledningssystemet"],
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": "^8.5",
        "dompdf/dompdf": "^3.1",
        "graphp/graph": "^1",
        "graphp/graphviz": "^1",
        "guzzlehttp/guzzle": "^7.2",
        "laravel/fortify": "^1.28",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.30",
        "laravel/tinker": "^3.0",
        "phpoffice/phpspreadsheet": "^2.1",
        "phpoffice/phpword": "^1.2",
        "pragmarx/google2fa": "^9.0",
        "predis/predis": "^3.2",
        "socialiteproviders/google": "^4.1",
        "socialiteproviders/microsoft-azure": "^5.2",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-permission": "^8.3",
        "spatie/laravel-query-builder": "^7.3"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.0",
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.8",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Ledningssystemet\\Ledningssystemet\\": "src/",
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --no-ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --no-ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --no-ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "providers": [
                "Ledningssystemet\\Ledningssystemet\\LedningssystemetServiceProvider"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
